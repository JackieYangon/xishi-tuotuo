# Copy this file to .env.local and provide your own deployment identifiers.
# Use the full cloud environment ID from the console, not its display name.
WECHAT_APPID=
CLOUD_ENV_ID=

# Optional: AppID of the mini program that owns a shared cloud environment.
# Its owner must authorize this mini program first. Leave blank for your own environment.
CLOUD_RESOURCE_APPID=

# Never put AppSecret, access tokens, or service credentials in this file.
