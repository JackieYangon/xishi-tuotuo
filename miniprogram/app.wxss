page { background: #faf7f2; color: #322c2c; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; font-size: 28rpx; line-height: 1.6; }
view, text, button, input, textarea { box-sizing: border-box; }
button { font-size: 28rpx; border-radius: 18rpx; margin: 0; line-height: 1.5; padding: 22rpx 28rpx; font-weight: 500; }
button::after { border: none; }
button[disabled] { opacity: .45; }
.container { padding: 32rpx 32rpx calc(52rpx + env(safe-area-inset-bottom)); }
.card { background: #fff; border: 1rpx solid #eee6dd; border-radius: 26rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(78,44,37,.025); }
.title { font-size: 44rpx; line-height: 1.35; font-weight: 650; letter-spacing: 1rpx; }
.subtitle { font-size: 26rpx; color: #8a7771; margin-top: 12rpx; }
.muted { color: #8a7771; font-size: 25rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.wrap { flex-wrap: wrap; }
.button-primary { background: #954b50; color: white; }
.button-secondary { background: #f2e9e3; color: #713f43; }
.button-text { background: transparent; color: #954b50; padding: 14rpx 8rpx; }
.field { margin: 24rpx 0; }
.label { display: block; color: #67534f; font-size: 26rpx; margin-bottom: 10rpx; }
.input { width: 100%; min-height: 88rpx; border: 1rpx solid #e8ded5; background: #fdfbf8; padding: 20rpx; border-radius: 14rpx; font-size: 29rpx; color: #322c2c; }
input.input { height: 88rpx; }
textarea.input { min-height: 150rpx; }
.empty { text-align: center; padding: 56rpx 28rpx; color: #8a7771; }
.empty .title { color: #4d3b38; font-size: 34rpx; margin-bottom: 14rpx; }
.chip, .pill { display: inline-block; padding: 6rpx 18rpx; border-radius: 100rpx; font-size: 23rpx; color: #81514f; background: #f7eeea; }
.danger { color: #b53b3b; }
.section-title { font-size: 31rpx; font-weight: 600; margin: 36rpx 0 18rpx; }
.notice { background: #f4ede2; color: #80643f; padding: 22rpx; border-radius: 18rpx; font-size: 25rpx; margin: 20rpx 0; }
.error { color: #a73f48; background: #f9eeeb; padding: 24rpx; border-radius: 18rpx; margin: 20rpx 0; }
.actions { display: flex; gap: 18rpx; margin-top: 28rpx; }
.actions button { flex: 1; }
.divider { height: 1rpx; background: #efe7e0; margin: 24rpx 0; }
.small { font-size: 24rpx; }
.spacer { height: 24rpx; }
.page-head { margin: 12rpx 0 32rpx; }
