<view class="container">
  <view class="page-head">
    <view class="title">把安排，交到手上</view>
    <view class="subtitle">整理成 Excel，方便家人和现场人员查阅。</view>
  </view>
  <view wx:if="loading" class="card empty">正在整理婚礼资料…</view>
  <view wx:elif="noGroup" class="card empty">
    <view class="title">先加入婚礼筹备</view>
    <view>创建或加入群组后，就能导出大家的安排。</view>
    <button class="button-primary export-start" bindtap="goGroup">前往筹备群组</button>
  </view>
  <view wx:elif="error" class="card">
    <view class="error">{{error}}</view>
    <button class="button-secondary" bindtap="load">重新读取</button>
  </view>
  <block wx:else>
    <view class="card">
      <view class="between"><view class="export-heading">{{title}}</view><view class="pill">Excel 表格</view></view>
      <view class="field">
        <view class="label">选择导出内容</view>
        <picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategory" disabled="{{generating}}">
          <view class="input between"><text>{{categories[categoryIndex].label}}</text><text class="muted">⌄</text></view>
        </picker>
      </view>
      <view class="muted">导出全部时，婚礼简况、事项、物品、商家、宾客、座位、流程和住宿将分别放在工作表中。</view>
      <view class="divider"></view>
      <view class="between export-switch">
        <view><view>包含联系电话</view><view class="muted small">宾客与商家的手机号或座机</view></view>
        <switch color="#954b50" checked="{{includePhones}}" data-key="includePhones" disabled="{{generating}}" bindchange="onPrivacy" />
      </view>
      <view class="between export-switch">
        <view><view>包含备注与回执留言</view><view class="muted small">筹备说明和亲友填写的留言</view></view>
        <switch color="#954b50" checked="{{includeNotes}}" data-key="includeNotes" disabled="{{generating}}" bindchange="onPrivacy" />
      </view>
      <view class="notice">默认不包含电话和备注，发送前可按接收人的需要选择。</view>
      <view wx:if="exportError" class="error">{{exportError}}</view>
      <button class="button-primary" loading="{{generating}}" disabled="{{generating || opening || sharing}}" bindtap="exportFile">{{generating ? '正在生成表格' : '生成 Excel 表格'}}</button>
    </view>
    <view wx:if="filePath" class="card export-result">
      <view class="pill">已生成</view>
      <view class="export-heading export-result-title">资料整理好了</view>
      <view class="muted">{{sheetCount}} 个工作表 · {{rowCount}} 行资料 · {{fileSize}}</view>
      <view class="export-filename small">{{fileName}}</view>
      <view class="actions">
        <button class="button-secondary" bindtap="openFile" loading="{{opening}}" disabled="{{opening || sharing || generating}}">预览表格</button>
        <button class="button-primary" bindtap="shareFile" loading="{{sharing}}" disabled="{{opening || sharing || generating}}">发送文件</button>
      </view>
      <view class="muted small export-footnote">这是生成时的资料快照；筹备内容更新后，请重新生成。</view>
    </view>
  </block>
</view>
