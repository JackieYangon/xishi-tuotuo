<view class="container">
  <view class="page-head"><view class="title">一家人，把喜事办妥。</view><view class="subtitle">新人、父母、帮忙的家人，一起分工，一起期待。</view></view>
  <view wx:if="loading" class="empty">正在同步群组…</view>
  <view wx:if="error" class="error">{{error}}<button class="button-text" bindtap="load">重新连接</button></view>
  <block wx:if="!loading">
    <view wx:if="!group || joinMode" class="card">
      <view class="between"><view class="section-title">{{joinMode ? '加入家人的婚礼' : '创建筹备群组'}}</view><button class="button-text" bindtap="toggleJoin">{{joinMode ? '我来创建' : '已有邀请码'}}</button></view>
      <view class="field"><text class="label">家人怎么称呼你</text><input class="input" value="{{nickname}}" data-key="nickname" bindinput="input" maxlength="30" placeholder="例如：小杨 / 新娘妈妈"/></view>
      <view class="field"><text class="label">你的身份</text><picker range="{{roles}}" value="{{roleIndex}}" bindchange="roleChange"><view class="input">{{roles[roleIndex]}} ▾</view></picker></view>
      <view wx:if="joinMode" class="field"><text class="label">家庭群组邀请码</text><input class="input" value="{{code}}" data-key="code" bindinput="input" maxlength="12" placeholder="输入家人发来的 12 位邀请码"/></view>
      <block wx:else><view class="field"><text class="label">婚礼名称</text><input class="input" value="{{profile.title}}" data-key="title" bindinput="profileInput" maxlength="60" placeholder="例如：我们的婚礼"/></view><view class="field"><text class="label">婚期（可以之后再定）</text><picker mode="date" value="{{profile.date}}" data-key="date" bindchange="profileInput"><view class="input">{{profile.date || '选择婚礼日期'}} ▾</view></picker></view></block>
      <view class="notice">加入群组后，成员可以共同查看和编辑婚礼资料、宾客名单与筹备事项。</view><button class="button-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="createOrJoin">{{joinMode ? '加入，一起筹备' : '创建我们的婚礼'}}</button>
    </view>
    <block wx:if="group && !joinMode">
      <view class="card"><view class="between"><view class="section-title">筹备家人 · {{group.members.length}} 人</view><text class="chip">共同编辑</text></view><view wx:for="{{group.members}}" wx:key="id" class="between member"><view><text class="member-name">{{item.nickname}}</text><text class="pill">{{item.role}}</text><text wx:if="item.id === group.ownerId" class="muted"> · 群主</text></view><button wx:if="isOwner && item.id !== group.selfId" class="button-text danger" data-id="{{item.id}}" bindtap="removeMember" disabled="{{busy}}">移除</button></view><view class="divider"></view><view class="muted">邀请码 · {{codeExpired ? '已过期，请群主更新' : '有效至 ' + expires}}</view><view class="invite-code">{{group.joinCode}}</view><view class="actions"><button class="button-secondary" bindtap="copyCode">复制邀请码</button><button class="button-primary" open-type="share" disabled="{{codeExpired}}">邀请家人</button></view><button wx:if="isOwner" class="button-text small" bindtap="rotateCode" disabled="{{busy}}">更新邀请码</button></view>
      <view class="card"><view class="section-title">我们的婚礼</view><view class="field"><text class="label">婚礼名称</text><input class="input" value="{{profile.title}}" data-key="title" bindinput="profileInput" maxlength="60"/></view><view class="couple-fields"><view class="field"><text class="label">新娘</text><input class="input" value="{{profile.bride}}" data-key="bride" bindinput="profileInput" maxlength="30" placeholder="新娘姓名"/></view><view class="field"><text class="label">新郎</text><input class="input" value="{{profile.groom}}" data-key="groom" bindinput="profileInput" maxlength="30" placeholder="新郎姓名"/></view></view><view class="field"><text class="label">婚礼日期</text><picker mode="date" value="{{profile.date}}" data-key="date" bindchange="profileInput"><view class="input">{{profile.date || '选择日期'}} ▾</view></picker></view><view class="field"><text class="label">场地名称</text><input class="input" value="{{profile.venue}}" data-key="venue" bindinput="profileInput" maxlength="100" placeholder="酒店或婚礼场地"/></view><view class="field"><text class="label">详细地址</text><input class="input" value="{{profile.address}}" data-key="address" bindinput="profileInput" maxlength="200" placeholder="亲友可按这个地址前往"/></view><view class="row"><button class="button-secondary" bindtap="chooseLocation">{{profile.latitude !== null ? '重新选择地图位置' : '添加地图导航'}}</button><button wx:if="profile.latitude !== null" class="button-text" bindtap="clearLocation">移除定位</button></view><view class="notice" wx:if="profile.latitude !== null">地图位置已选好，保存后亲友可在请柬中一键导航。</view></view>
      <view class="card"><view class="section-title">电子请柬样式</view><image wx:if="coverUrl" class="cover" src="{{coverUrl}}" mode="aspectFill"/><button class="button-secondary" bindtap="pickImage" disabled="{{busy}}">{{profile.coverFileID ? '更换合照' : '添加一张合照'}}</button><view class="muted small">JPG / PNG，2MB 以内</view><view class="field"><text class="label">请柬主题</text><picker range="{{themes}}" value="{{themeIndex}}" bindchange="themeChange"><view class="input">{{themes[themeIndex]}} ▾</view></picker></view><view class="field"><text class="label">想对亲友说的话</text><textarea class="input" value="{{profile.invitationText}}" data-key="invitationText" bindinput="profileInput" maxlength="2000"/></view><view class="row"><button class="button-secondary" bindtap="pickMusic" disabled="{{busy}}">{{profile.musicFileID ? '更换背景音乐' : '添加背景音乐'}}</button><button wx:if="profile.musicFileID" class="button-text" bindtap="clearMusic">移除</button></view><view class="muted small">从微信文件选择 MP3，2MB 以内</view></view>
      <button class="button-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveProfile">保存婚礼资料与请柬</button><button class="button-text" bindtap="home">返回婚礼首页</button>
    </block>
    <view wx:if="groups.length" class="card groups"><view class="section-title">我参与的婚礼</view><button wx:for="{{groups}}" wx:key="id" class="group-choice between" bindtap="selectGroup" data-id="{{item.id}}" disabled="{{busy}}"><text>{{item.title}}</text><text class="muted">{{item.date || '婚期待定'}} ›</text></button></view>
  </block>
</view>
