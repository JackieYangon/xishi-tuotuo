<view class="container manage-page">
  <view class="page-heading">
    <view class="eyebrow">一起筹备 · 喜事妥妥</view>
    <view class="title">{{config.title}}</view>
    <view class="subtitle">{{config.subtitle}}</view>
  </view>

  <view wx:if="loading && !allCount" class="card empty">正在整理{{config.title}}…</view>
  <view wx:elif="error" class="card empty">
    <view class="error-title">{{noGroup ? '先加入筹备群组' : '暂时没有连接上'}}</view>
    <view class="muted error-description">{{error}}</view>
    <button wx:if="noGroup" class="button-primary" bindtap="goGroup">创建或加入群组</button>
    <button wx:else class="button-secondary" bindtap="load">重新加载</button>
  </view>
  <block wx:else>
    <view class="stats-bar">
      <view class="stat" wx:for="{{stats}}" wx:key="label">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>
    <view wx:if="type === 'guests'" class="soft-notice">
      <text>一份名单，串联请柬、排桌与住宿。</text>
      <button class="text-action" bindtap="goSeats">去排桌 →</button>
    </view>
    <view wx:if="type === 'lodgings' && lodgingUnassigned" class="soft-notice">
      <text>还有 {{lodgingUnassigned}} 位需要住宿的亲友待安排。</text>
    </view>
    <view class="search-box">
      <text class="search-symbol">⌕</text>
      <input class="search-input" value="{{query}}" placeholder="{{config.search}}" bindinput="onSearch" maxlength="80" confirm-type="search" />
    </view>
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <view wx:for="{{config.filters}}" wx:key="value" class="filter-chip {{filter === item.value ? 'filter-active' : ''}}" data-value="{{item.value}}" bindtap="onFilter">{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="list-caption">{{query || filter !== 'all' ? '筛选结果' : '全部记录'}} · {{total}} {{type === 'guests' ? '组' : '条'}}<text wx:if="loading"> · 更新中</text></view>

    <view wx:if="!rows.length" class="card empty">
      <view class="empty-mark">{{allCount ? '⌕' : '＋'}}</view>
      <view>{{allCount ? '没有找到符合条件的记录' : config.empty}}</view>
      <view class="muted empty-help">{{allCount ? '换个关键词，或查看其他分类' : '添加后，群组成员就能一起查看和更新'}}</view>
    </view>

    <view wx:for="{{rows}}" wx:key="id" class="card record-card {{type === 'tasks' && item.done ? 'record-complete' : ''}}">
      <view class="record-top">
        <button wx:if="type === 'tasks'" class="check-button {{item.done ? 'is-checked' : ''}}" data-id="{{item.id}}" bindtap="toggleDone" disabled="{{!!pendingId}}" aria-label="{{item.done ? '标记未完成' : '标记完成'}}">{{item.done ? '✓' : ''}}</button>
        <view class="record-main" data-id="{{item.id}}" bindtap="openEdit">
          <view class="record-title">{{item.heading}}</view>
          <view class="record-details">
            <text wx:for="{{item.details}}" wx:for-item="detail" wx:for-index="detailIndex" wx:key="*this">{{detailIndex ? ' · ' : ''}}{{detail}}</text>
          </view>
        </view>
        <view class="record-status {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view wx:if="type === 'vendors'" class="extra-line">
        <text>{{item.quoteLabel}}</text>
        <text wx:if="item.phone" class="phone-link" data-phone="{{item.phone}}" bindtap="callVendor">{{item.phone}}</text>
      </view>
      <view wx:if="type === 'guests'" class="extra-line">
        <text>{{item.seatLabel}}</text>
        <text wx:if="item.needsLodging" class="small-tag">需住宿</text>
        <text wx:if="item.phone" class="muted">{{item.phone}}</text>
      </view>
      <view wx:if="type === 'lodgings' && item.guestNames" class="extra-line guest-names">入住：{{item.guestNames}}</view>
      <view wx:if="type === 'guests' && item.replyNote" class="record-note">回执留言：{{item.replyNote}}</view>
      <view wx:if="item.note" class="record-note">{{item.note}}</view>
      <view class="record-actions">
        <button wx:if="type === 'guests'" class="mini-action accent-action" data-id="{{item.id}}" bindtap="invite" disabled="{{!!pendingId}}">发请柬</button>
        <button wx:if="type === 'items' && item.status !== 'ready'" class="mini-action accent-action" data-id="{{item.id}}" bindtap="advanceItem" loading="{{pendingId === item.id}}" disabled="{{!!pendingId}}">{{item.status === 'pending' ? '标记已购买' : '标记已备齐'}}</button>
        <view class="action-spacer"></view>
        <button class="mini-action" data-id="{{item.id}}" bindtap="openEdit" disabled="{{!!pendingId}}">编辑</button>
        <button class="mini-action delete-action" data-id="{{item.id}}" bindtap="remove" disabled="{{!!pendingId}}">删除</button>
      </view>
    </view>

    <view class="bottom-action">
      <button class="button-primary add-button" bindtap="openAdd" disabled="{{loading || !!pendingId}}">＋ 添加{{config.singular}}</button>
    </view>
  </block>
</view>

<view wx:if="editorOpen" class="editor-mask" catchtap="closeEditor" catchtouchmove="stopTap">
  <view class="editor-sheet" catchtap="stopTap">
    <view class="editor-heading">
      <view>
        <view class="eyebrow">群组共同维护</view>
        <view class="editor-title">{{editingId ? '编辑' : '添加'}}{{config.singular}}</view>
      </view>
      <button class="close-editor" bindtap="closeEditor" disabled="{{saving}}" aria-label="关闭编辑">×</button>
    </view>
    <scroll-view class="editor-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="editor-body">
        <view wx:for="{{fields}}" wx:key="key" wx:for-item="field" class="field form-field">
          <view class="label">{{field.label}}<text wx:if="field.required" class="required-mark"> *</text></view>
          <input wx:if="field.kind === 'text' || field.kind === 'phone' || field.kind === 'number' || field.kind === 'decimal'" class="input form-input" value="{{form[field.key]}}" type="{{field.kind === 'number' || field.kind === 'phone' ? 'number' : field.kind === 'decimal' ? 'digit' : 'text'}}" maxlength="{{field.kind === 'number' || field.kind === 'decimal' ? 12 : field.max}}" placeholder="{{field.placeholder || '请输入'}}" data-key="{{field.key}}" bindinput="onInput" disabled="{{saving}}" />
          <textarea wx:elif="field.kind === 'textarea'" class="input form-textarea" value="{{form[field.key]}}" maxlength="{{field.max}}" placeholder="{{field.placeholder}}" data-key="{{field.key}}" bindinput="onInput" disabled="{{saving}}" auto-height />
          <view wx:elif="field.kind === 'date' || field.kind === 'time'" class="date-field-row">
            <picker mode="{{field.kind}}" value="{{form[field.key]}}" data-key="{{field.key}}" bindchange="onPicker" disabled="{{saving}}" class="date-picker">
              <view class="input picker-value {{!form[field.key] ? 'placeholder' : ''}}">{{form[field.key] || (field.kind === 'date' ? '选择日期' : '选择时间')}}<text class="picker-arrow">⌄</text></view>
            </picker>
            <button wx:if="!field.required && form[field.key]" class="clear-date" data-key="{{field.key}}" bindtap="clearDate" disabled="{{saving}}">清除</button>
          </view>
          <picker wx:elif="field.kind === 'select' || field.kind === 'member'" range="{{field.options}}" range-key="label" value="{{field.selected}}" data-key="{{field.key}}" bindchange="onPicker" disabled="{{saving}}">
            <view class="input picker-value">{{field.display}}<text class="picker-arrow">⌄</text></view>
          </picker>
          <view wx:elif="field.kind === 'switch'" class="switch-line">
            <text class="muted">{{form[field.key] ? '是' : '否'}}</text>
            <switch checked="{{form[field.key]}}" data-key="{{field.key}}" bindchange="onSwitch" color="#984354" disabled="{{saving}}" />
          </view>
          <view wx:elif="field.kind === 'guests'" class="guest-picker">
            <view class="guest-picker-hint">已选择 {{field.selectedCount}} 人（按宾客同行人数计算）</view>
            <checkbox-group bindchange="onGuestsChange">
              <label wx:for="{{field.choices}}" wx:key="id" wx:for-item="guest" class="guest-choice">
                <checkbox value="{{guest.id}}" checked="{{guest.checked}}" color="#984354" disabled="{{saving}}" />
                <view class="guest-choice-name">{{guest.name}}<text class="guest-choice-detail">{{guest.partySize}} 人{{guest.notAttending ? ' · 已回复不出席，可取消分配' : guest.needsLodging ? ' · 需住宿' : ''}}</text></view>
              </label>
            </checkbox-group>
            <view wx:if="!field.choices.length" class="muted guest-picker-hint">请先在宾客名单中添加亲友。</view>
          </view>
        </view>
        <view wx:if="draftError" class="draft-error">{{draftError}}</view>
        <button wx:if="editorConflict" class="button-secondary" bindtap="reloadEditor" disabled="{{saving}}">重新载入最新记录</button>
        <view wx:if="type === 'guests'" class="muted form-help">人数包含同行亲友。请柬回复会自动更新到这份名单；修改人数可能影响已安排的桌位。</view>
      </view>
    </scroll-view>
    <view class="editor-footer">
      <button class="button-secondary cancel-button" bindtap="closeEditor" disabled="{{saving}}">取消</button>
      <button class="button-primary save-button" bindtap="save" loading="{{saving}}" disabled="{{saving || editorConflict}}">{{saving ? '正在保存' : '保存'}}</button>
    </view>
  </view>
</view>
